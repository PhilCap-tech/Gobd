{
  "name": "gobd-verfahrensdoku",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "node --disable-warning=ExperimentalWarning scripts/check-forbidden-words.mjs && node --disable-warning=ExperimentalWarning scripts/check-sie-ansprache.mjs && npm run check:export && npm run check:pdf && npm run check:keine",
    "check:ansprache": "node --disable-warning=ExperimentalWarning scripts/check-sie-ansprache.mjs",
    "check:export": "tsx scripts/check-export-mvp.ts",
    "check:pdf": "tsx scripts/check-pdf-consistency.ts",
    "check:keine": "tsx scripts/check-keine-angaben.ts",
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/run-preview-draft-smoke.mjs",
    "start": "next start",
    "lint": "eslint",
    "check:admin-wipe": "npx --yes tsx scripts/check-admin-wipe.ts"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "googleapis": "^144.0.0",
    "next": "16.3.5",
    "pdfkit": "^0.20.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.28.1",
    "stripe": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
