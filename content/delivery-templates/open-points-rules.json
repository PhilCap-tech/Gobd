{
  "version": "2.0.0",
  "emptyValues": [
    "",
    null,
    "nicht angegeben",
    "k.A.",
    "ka",
    "n/a",
    "none"
  ],
  "arrayEmptyMeansOpen": true,
  "rules": [
    {
      "id": "op-company",
      "field": "identity.company",
      "chapter": "02-zielsetzung",
      "severity": "high",
      "when": "empty",
      "text": "Firmenname fehlt in der Identität — Titelseite und Kapitel 2.2 unvollständig."
    },
    {
      "id": "op-branchen",
      "field": "answers.branchen",
      "chapter": "02-zielsetzung",
      "severity": "medium",
      "when": "empty",
      "text": "Branche(n) fehlen — bitte nachtragen."
    },
    {
      "id": "op-rechtsform",
      "field": "answers.rechtsform",
      "chapter": "02-zielsetzung",
      "severity": "medium",
      "when": "empty",
      "text": "Rechtsform fehlt — bitte nachtragen."
    },
    {
      "id": "op-mitarbeitende",
      "field": "answers.mitarbeitende",
      "chapter": "02-zielsetzung",
      "severity": "low",
      "when": "empty",
      "text": "Angabe zu Mitarbeitenden fehlt."
    },
    {
      "id": "op-fibu",
      "field": "answers.fibu",
      "chapter": "03-organisation",
      "severity": "high",
      "when": "empty",
      "text": "FiBu-/Buchhaltungssoftware nicht angegeben — zentral für die Verfahrensdokumentation."
    },
    {
      "id": "op-weitere-systeme",
      "field": "answers.weitereSysteme",
      "chapter": "03-organisation",
      "severity": "low",
      "when": "empty",
      "text": "Weitere Systeme nicht angegeben (optional, aber empfohlen bei Neben-Tools)."
    },
    {
      "id": "op-eingangsbelege",
      "field": "answers.eingangsbelege",
      "chapter": "02-zielsetzung",
      "severity": "high",
      "when": "empty",
      "text": "Weg der Eingangsbelege fehlt."
    },
    {
      "id": "op-ausgangsrechnungen",
      "field": "answers.ausgangsrechnungen",
      "chapter": "02-zielsetzung",
      "severity": "high",
      "when": "empty",
      "text": "Weg der Ausgangsrechnungen fehlt."
    },
    {
      "id": "op-archiv",
      "field": "answers.archiv",
      "chapter": "03-organisation",
      "severity": "high",
      "when": "empty",
      "text": "Archivierung der Belege nicht angegeben."
    },
    {
      "id": "op-hosting",
      "field": "answers.hosting",
      "chapter": "03-organisation",
      "severity": "medium",
      "when": "empty",
      "text": "Hosting-Angabe fehlt."
    },
    {
      "id": "op-backup",
      "field": "answers.backup",
      "chapter": "03-organisation",
      "severity": "high",
      "when": "empty",
      "text": "Backup-Verfahren nicht angegeben."
    },
    {
      "id": "op-zugriff",
      "field": "answers.zugriff",
      "chapter": "03-organisation",
      "severity": "high",
      "when": "empty",
      "text": "Zugriff / Berechtigungen nicht angegeben."
    },
    {
      "id": "op-gf",
      "field": "answers.gf",
      "chapter": "01-vorbemerkungen",
      "severity": "medium",
      "when": "empty",
      "text": "Geschäftsführung / Gesamtverantwortung nicht benannt."
    },
    {
      "id": "op-buchhaltung",
      "field": "answers.buchhaltung",
      "chapter": "03-organisation",
      "severity": "medium",
      "when": "empty",
      "text": "Buchhaltungsverantwortliche Person / Stelle nicht benannt."
    },
    {
      "id": "op-it",
      "field": "answers.it",
      "chapter": "03-organisation",
      "severity": "low",
      "when": "empty",
      "text": "IT-/Systemverantwortung nicht benannt."
    },
    {
      "id": "op-steuerberater",
      "field": "answers.steuerberater",
      "chapter": "03-organisation",
      "severity": "low",
      "when": "empty",
      "text": "Steuerberatung nicht angegeben (falls vorhanden, nachtragen)."
    },
    {
      "id": "op-zertifikate",
      "when": "always",
      "chapter": "03-organisation",
      "severity": "low",
      "text": "Softwarebescheinigungen / Zertifikate der eingesetzten Systeme sind im Intake nicht erfasst."
    },
    {
      "id": "op-speicherpfad",
      "when": "always",
      "chapter": "03-organisation",
      "severity": "low",
      "text": "Konkreter Archiv-Datenpfad / Speicherort ist im Intake nicht erfasst."
    },
    {
      "id": "op-mitgeltende",
      "when": "always",
      "chapter": "06-mitgeltende-unterlagen",
      "severity": "low",
      "text": "Weitere mitgeltende Unterlagen (außer dieser VD) wurden nicht geliefert."
    },
    {
      "id": "op-turnus",
      "when": "always",
      "chapter": "04-verfahren-papier",
      "severity": "low",
      "text": "Turnus der Belegsicherung ist im Intake nicht erfasst — Default-Formulierung verwendet."
    }
  ],
  "outputItemShape": {
    "id": "string",
    "text": "string",
    "severity": "low|medium|high",
    "chapter": "chapter-id",
    "field": "dotted.path"
  }
}
