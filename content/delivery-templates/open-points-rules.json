{
  "version": "3.0.0",
  "emptyValues": [
    "",
    null,
    "nicht angegeben",
    "zu bestätigen",
    "k.A.",
    "ka",
    "n/a",
    "none",
    "offen"
  ],
  "arrayEmptyMeansOpen": true,
  "rules": [
    {
      "id": "op-company",
      "field": "identity.company",
      "chapter": "00-cover",
      "severity": "high",
      "when": "empty",
      "customerFacing": true,
      "responsibilityField": "answers.gf",
      "text": "Firmenname fehlt — Titel und Merkmalübersicht unvollständig."
    },
    {
      "id": "op-branchen",
      "field": "answers.branchen",
      "chapter": "01-merkmal-tabelle",
      "severity": "medium",
      "when": "empty",
      "customerFacing": true,
      "responsibilityField": "answers.gf",
      "text": "Branche(n) fehlen — Betriebsbeschreibung in der Merkmalübersicht unvollständig."
    },
    {
      "id": "op-rechtsform",
      "field": "answers.rechtsform",
      "chapter": "01-merkmal-tabelle",
      "severity": "medium",
      "when": "empty",
      "customerFacing": true,
      "responsibilityField": "answers.gf",
      "text": "Rechtsform fehlt — bitte nachtragen."
    },
    {
      "id": "op-mitarbeitende",
      "field": "answers.mitarbeitende",
      "chapter": "01-merkmal-tabelle",
      "severity": "low",
      "when": "empty",
      "customerFacing": true,
      "responsibilityField": "answers.gf",
      "text": "Angabe zu Mitarbeitenden fehlt."
    },
    {
      "id": "op-fibu",
      "field": "answers.fibu",
      "chapter": "03-systeme-belegarten",
      "severity": "high",
      "when": "empty",
      "customerFacing": true,
      "responsibilityField": "answers.buchhaltung",
      "text": "FiBu-/Buchhaltungssoftware nicht angegeben — Systeme und Buchungsübergabe unklar."
    },
    {
      "id": "op-weitere-systeme",
      "field": "answers.weitereSysteme",
      "chapter": "03-systeme-belegarten",
      "severity": "medium",
      "when": "empty",
      "customerFacing": true,
      "responsibilityField": "answers.buchhaltung",
      "text": "Prüfen, ob weitere belegrelevante Vorsysteme oder Portale verwendet werden; erst danach Geltungsbereich bestätigen."
    },
    {
      "id": "op-eingangsbelege",
      "field": "answers.eingangsbelege",
      "chapter": "04-eingang-pruefung",
      "severity": "high",
      "when": "empty",
      "customerFacing": true,
      "responsibilityField": "answers.buchhaltung",
      "text": "Weg der Eingangsbelege fehlt — Eingang und Prüfung nicht parametrisierbar."
    },
    {
      "id": "op-ausgangsrechnungen",
      "field": "answers.ausgangsrechnungen",
      "chapter": "05-freigabe-buchung",
      "severity": "high",
      "when": "empty",
      "customerFacing": true,
      "responsibilityField": "answers.gf",
      "text": "Weg der Ausgangsrechnungen fehlt — Erstellung und Nummerierung unvollständig."
    },
    {
      "id": "op-archiv",
      "field": "answers.archiv",
      "chapter": "06-aufbewahrung",
      "severity": "high",
      "when": "empty",
      "customerFacing": true,
      "responsibilityField": "answers.buchhaltung",
      "text": "Archivierung der Belege nicht angegeben — Ablage und Langzeitarchiv unklar."
    },
    {
      "id": "op-hosting",
      "field": "answers.hosting",
      "chapter": "06-aufbewahrung",
      "severity": "medium",
      "when": "empty",
      "customerFacing": true,
      "responsibilityField": "answers.it",
      "text": "Hosting-Angabe fehlt — Aufbewahrungsort (Inland/EU/Drittland) ist zu bestätigen."
    },
    {
      "id": "op-backup",
      "field": "answers.backup",
      "chapter": "06-aufbewahrung",
      "severity": "high",
      "when": "empty",
      "customerFacing": true,
      "responsibilityField": "answers.it",
      "text": "Backup-Verfahren nicht angegeben — Sicherung gegen Verlust ist zu beschreiben."
    },
    {
      "id": "op-backup-test",
      "field": "answers.backup",
      "chapter": "06-aufbewahrung",
      "severity": "high",
      "when": "always",
      "customerFacing": true,
      "responsibilityField": "answers.gf",
      "text": "Anbieterunterlagen zu Backup und Rücksicherung beiziehen und tatsächlichen Wiederherstellungstest dokumentieren."
    },
    {
      "id": "op-zugriff",
      "field": "answers.zugriff",
      "chapter": "06-aufbewahrung",
      "severity": "high",
      "when": "empty",
      "customerFacing": true,
      "responsibilityField": "answers.gf",
      "text": "Zugriff / Berechtigungskreis nicht angegeben."
    },
    {
      "id": "op-berechtigungsliste",
      "field": "answers.zugriff",
      "chapter": "06-aufbewahrung",
      "severity": "medium",
      "when": "always",
      "customerFacing": true,
      "responsibilityField": "answers.gf",
      "text": "Berechtigungsliste und Mandatsumfang der Kanzlei (soweit beteiligt) als mitgeltende Unterlagen ablegen."
    },
    {
      "id": "op-gf",
      "field": "answers.gf",
      "chapter": "01-merkmal-tabelle",
      "severity": "high",
      "when": "empty",
      "customerFacing": true,
      "responsibilityField": null,
      "text": "Geschäftsführung / Gesamtverantwortung nicht benannt — Freigabe und Bestätigung offen."
    },
    {
      "id": "op-buchhaltung",
      "field": "answers.buchhaltung",
      "chapter": "01-merkmal-tabelle",
      "severity": "high",
      "when": "empty",
      "customerFacing": true,
      "responsibilityField": "answers.gf",
      "text": "Buchhaltungsverantwortliche Person / Stelle nicht benannt."
    },
    {
      "id": "op-it",
      "field": "answers.it",
      "chapter": "01-merkmal-tabelle",
      "severity": "medium",
      "when": "empty",
      "customerFacing": true,
      "responsibilityField": "answers.gf",
      "text": "IT-/Systemverantwortung nicht benannt — Backup und Rechteverwaltung unsicher."
    },
    {
      "id": "op-steuerberater",
      "field": "answers.steuerberater",
      "chapter": "01-merkmal-tabelle",
      "severity": "low",
      "when": "empty",
      "customerFacing": true,
      "responsibilityField": "answers.gf",
      "text": "Steuerberatung nicht angegeben (nachtragen, falls an der Belegverarbeitung beteiligt)."
    },
    {
      "id": "op-erechnung-validierung",
      "field": "answers.eingangsbelege",
      "chapter": "04-eingang-pruefung",
      "severity": "high",
      "when": "arrayContainsAny",
      "tokens": ["E-Rechnung", "eRechnung", "ZUGFeRD", "XRechnung", "XML"],
      "customerFacing": true,
      "responsibilityField": "answers.it",
      "text": "Verfahren und Nachweis der technischen Prüfung strukturierter E-Rechnungen konkretisieren und protokollieren."
    },
    {
      "id": "op-kontrollprotokoll",
      "field": null,
      "chapter": "07-kontrollen-aenderungen",
      "severity": "medium",
      "when": "always",
      "customerFacing": true,
      "responsibilityField": "answers.gf",
      "text": "Kontrollroutine (z. B. Stichprobe) und Kontrollprotokoll betrieblich festlegen und dokumentieren — im Intake nicht bestätigt."
    },
    {
      "id": "op-papier-klarheit",
      "field": "answers.eingangsbelege",
      "chapter": "04-eingang-pruefung",
      "severity": "low",
      "when": "arrayContainsAny",
      "tokens": ["Papier", "Post", "Scan", "Papierbeleg"],
      "customerFacing": true,
      "responsibilityField": "answers.buchhaltung",
      "text": "Umgang mit Papieroriginalen klären (zusätzliche Verwahrung vs. dokumentiertes ersetzendes Scannen) und in einer Folgefassung bestätigen."
    },
    {
      "id": "op-email-internal",
      "field": "identity.email",
      "chapter": "00-cover",
      "severity": "low",
      "when": "empty",
      "customerFacing": false,
      "text": "Kontakt-E-Mail fehlt in der Identität (nur intern / Delivery)."
    },
    {
      "id": "op-stripe-session-internal",
      "field": "identity.stripeSessionId",
      "chapter": "00-cover",
      "severity": "low",
      "when": "empty",
      "customerFacing": false,
      "text": "Stripe-Session-Referenz fehlt (nur intern / Delivery)."
    },
    {
      "id": "op-stripe-customer-internal",
      "field": "identity.stripeCustomerId",
      "chapter": "00-cover",
      "severity": "low",
      "when": "empty",
      "customerFacing": false,
      "text": "Stripe-Kundenreferenz fehlt (nur intern / Delivery)."
    }
  ],
  "outputItemShape": {
    "id": "string",
    "text": "string",
    "severity": "low|medium|high",
    "chapter": "chapter-id",
    "field": "dotted.path|null",
    "customerFacing": "boolean",
    "responsibility": "string (resolved from responsibilityField or fallback)"
  },
  "whenSemantics": {
    "empty": "Field missing, null, empty string/array, or value in emptyValues",
    "always": "Always emit (claim-safety OP); still respect customerFacing",
    "arrayContainsAny": "Emit when field array/string contains any of tokens (case-insensitive, alias-aware)"
  }
}
