# App
# Lokal:
NEXT_PUBLIC_APP_URL=http://localhost:3000
#
# Produktion (Vercel) — Pflicht, Build-Zeit:
# NEXT_PUBLIC_APP_URL=https://www.gobd-doku-erstellen.de
# Immer die kanonische www-URL, https, kein trailing slash.
# Nicht https://gobd-doku-erstellen.de (Apex 308t auf www und kann session_id verlieren).

# Stripe (Testmodus). Ohne diese Keys: Checkout leitet als Stub zum Intake.
# Preise in Stripe anlegen: einmalig 149 EUR + Abo 49 EUR / Monat (EUR).
STRIPE_SECRET_KEY=
STRIPE_PRICE_SETUP_ID=
STRIPE_PRICE_MONTHLY_ID=
# Customer Portal (Abo verwalten) braucht STRIPE_SECRET_KEY plus stripe_customer_id
# (Webhook/Intake schreiben die ID; Account/Portal listen sonst Stripe-Kunden nach E-Mail).
# Signing secret from `stripe listen` (local, whsec_…) or Dashboard → Developers → Webhooks.
# Production: required. POST /api/stripe/webhook returns 503 if missing.
# Do not invent a placeholder secret in code or .env.example.
STRIPE_WEBHOOK_SECRET=

# Google Sheets (Service Account). Ohne diese Werte: Intake landet lokal in
# .data/intakes.json, Readiness-Leads in .data/readiness-leads.json; auf Vercel
# (VERCEL=1) unter os.tmpdir()/gobd-data/.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB=intakes
# Freier Readiness-Check: eigene Tabelle, Default readiness_leads.
# Fehlt das Tab, legt die App es an (Service Account braucht Bearbeiter-Recht).
GOOGLE_SHEETS_READINESS_TAB=readiness_leads

# Vercel Blob — PDF-Ablage. Ohne Token: lokale Datei (.data/pdfs bzw. /tmp).
BLOB_READ_WRITE_TOKEN=

# E-Mail (Resend). Ohne diese Werte: kein Versand, nur Log-Stub; Download bleibt
# auf der Success-Seite. Lokal zeigt /login den Magic-Link als Demo-Banner.
RESEND_API_KEY=
EMAIL_FROM=

# Magic-Link- und Session-Signatur. Ohne Wert: unsicherer Dev-Fallback.
# In Produktion setzen (langes Zufallsgeheimnis).
MAGIC_LINK_SECRET=

# Ads tracking (consent-gated). Public vars are inlined at build time —
# after changing them on Vercel, redeploy. Unset = no Pixel/gtag, no errors.
# Stripe stays TEST: do not fire Purchase / InitiateCheckout.
NEXT_PUBLIC_META_PIXEL_ID=
# Optional stub, ReadinessSubmit only (AW-XXXX or AW-XXXX/label).
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=
